# --- Supabase ---
# Project URL + anon (publishable) key from Supabase → Project Settings → API.
# Never commit real secrets. Anon key is safe for NEXT_PUBLIC_* client use with RLS.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- MTN MoMo Open API ---
# Live (real) provider requires ALL of:
#   MOMO_API_USER, MOMO_API_KEY, MOMO_SUBSCRIPTION_KEY, and MOMO_TARGET_ENV=production
# Missing any key OR MOMO_TARGET_ENV=sandbox → SandboxMockProvider.
# NEVER commit production secrets. Set them in your host env (e.g. Vercel).
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
# sandbox (default) | production
MOMO_TARGET_ENV=sandbox
# Optional override; defaults to sandbox.momodeveloper.mtn.com or proxy.momoapi.mtn.com
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MOMO_CALLBACK_URL=
