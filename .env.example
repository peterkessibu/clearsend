# --- Supabase ---
# Project URL + anon (publishable) key from Supabase → Project Settings → API.
# Never commit real secrets. Anon key is safe for NEXT_PUBLIC_* client use with RLS.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- MTN MoMo Open API (optional) ---
# If ANY of these are missing, ClearSend uses SandboxMockProvider (simulated success).
# NEVER claim live settlement without real keys + approved product access.
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
# sandbox | production
MOMO_TARGET_ENV=sandbox
# Optional override; defaults to sandbox.momodeveloper.mtn.com or proxy.momoapi.mtn.com
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_URL=
