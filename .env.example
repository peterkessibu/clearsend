# --- Database ---
# Local demo (SQLite). File lives at prisma/dev.db after `npx prisma db push`.
DATABASE_URL="file:./dev.db"
# Production / Vercel: use Postgres (Neon, Supabase, Vercel Postgres, etc.)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clearsend?sslmode=require"
# Then change prisma/schema.prisma datasource provider to "postgresql" and run prisma migrate.

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional; Auth.js infers from request host. Set explicitly in production:
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL is also accepted by Auth.js v5
# AUTH_URL="https://your-domain.vercel.app"

# --- MTN MoMo Open API (optional) ---
# If ANY of these are missing, ClearSend uses SandboxMockProvider (simulated success).
# NEVER claim live settlement without real keys + approved product access.
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
# sandbox | production
MOMO_TARGET_ENV=sandbox
# Optional override; defaults to sandbox.momodeveloper.mtn.com or proxy.momoapi.mtn.com
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_URL=
